{
  "name": "@ball6847/git-commit-ai",
  "version": "1.1.0",
  "exports": "./src/cli.ts",
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md"
    ]
  },
  "tasks": {
    "start": "deno run --allow-run --allow-env --allow-read --allow-write --allow-net src/cli.ts",
    "dev": "deno run --allow-run --allow-env --allow-read --allow-write --allow-net --watch src/cli.ts",
    "check": "deno fmt --check && deno lint && deno test -A ./",
    "test": "deno test -A tests/",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "local-install": "deno install -fr --global --allow-run --allow-env --allow-read --allow-write --allow-net  --allow-sys --config deno.json --name git-commit-ai-local ./src/cli.ts",
    "publish:dry": "deno publish --dry-run"
  },
  "imports": {
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@^4.0.9",
    "@ai-sdk/cerebras": "npm:@ai-sdk/cerebras@^3.0.9",
    "@ai-sdk/openai": "npm:@ai-sdk/openai@^4.0.9",
    "@ai-sdk/mistral": "npm:@ai-sdk/mistral@^4.0.8",
    "@ai-sdk/openai-compatible": "npm:@ai-sdk/openai-compatible@^3.0.9",
    "@ai-sdk/provider": "npm:@ai-sdk/provider@^4.0.3",
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2.1",
    "@openrouter/ai-sdk-provider": "npm:@openrouter/ai-sdk-provider@^3.0.0",
    "@std/fmt/colors": "jsr:@std/fmt@^1.0.10/colors",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.7",
    "@std/path": "jsr:@std/path@^1.1.6",
    "ai": "npm:ai@^7.0.9",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "ts-mockito": "npm:ts-mockito@^2.6.1",
    "typescript-result": "npm:typescript-result@^3.5.2"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "es2022"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
